{
  "name": "vertexguard",
  "version": "1.0.0",
  "private": true,
  "description": "VertexGuard — real-time LLM data analytics shield: semantic verification + statistical audit + governance for NL-to-SQL answers",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev --workspace apps/api\" \"npm:dev --workspace apps/web\"",
    "build": "npm run build --workspace apps/web && npm run build --workspace apps/api",
    "start": "npm run start --workspace apps/api",
    "seed": "npm run seed --workspace apps/api",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "puppeteer-core": "^25.11.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
