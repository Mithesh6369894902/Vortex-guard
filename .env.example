# ---------------------------------------------------------------------------
# VertexGuard Configuration
# ---------------------------------------------------------------------------

# -- Database ---------------------------------------------------------------
# Set DATABASE_URL to use a production PostgreSQL (cloud / docker).
# Leave empty to use the embedded PostgreSQL (PGlite) engine — zero install.
DATABASE_URL=

# -- Server -----------------------------------------------------------------
PORT=4100
WEB_ORIGIN=http://localhost:4200

# -- AI & LLM Engine --------------------------------------------------------
# agent = Dynamic AI Chatbot Agent (answers ANY question using intelligent NLP SQL compiler)
# Optional Live API Keys for direct Cloud LLM inference (Gemini, OpenAI):
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
LLM_ENGINE=agent

# -- Governance Defaults ----------------------------------------------------
GOVERNANCE_DEFAULT_ROLE=analyst
GOVERNANCE_REDACT_PII=true